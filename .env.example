# Existing MongoDB + MinIO services.
# Copy this file to .env and replace every placeholder. Do not commit .env.
TERRA_AOI_ID=example-aoi

# Required by the always-on forecaster API. Keep this value private and pass
# it as the X-API-Key header when submitting or reading forecast jobs.
FORECAST_API_TOKEN=replace-with-a-long-random-api-token
# FORECAST_API_HOST_PORT=18001
# FORECAST_JOB_LEASE_SECONDS=86400

# Complete MongoDB URI. It can point to a local service, Docker network alias,
# remote host, or a host-side SSH tunnel (host.docker.internal from Docker Desktop).
MONGO_URI=mongodb://terra_app:replace-with-password@mongo.example.org:27017/terra_db?authSource=terra_db

# Command for SSH Tunneling to a remote MongoDB host. The command must be run in the background before starting the application.
# Example host-side command (run separately, never inside this env file):
# ssh -N -L 127.0.0.1:37017:172.21.0.3:27017 terra@SERVER_IP



# MinIO S3 API endpoint and application credentials (not root credentials).
MINIO_ENDPOINT=https://minio.example.org
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET_NAME=terra-uc1
# Use false only for a trusted development endpoint with a self-signed certificate.
MINIO_VERIFY_TLS=true
# MINIO_CA_BUNDLE=/absolute/path/for/your/minio-ca.pem

# Required only when running the satellite collection pipeline.
CDSE_CLIENT_ID=replace-with-your-cdse-client-id
CDSE_CLIENT_SECRET=replace-with-your-cdse-client-secret
# Optional sequential fallback pairs. Add only complete ID/secret pairs.
# CDSE_BACKUP_CLIENT_ID=replace-with-first-backup-client-id
# CDSE_BACKUP_CLIENT_SECRET=replace-with-first-backup-client-secret
# CDSE_BACKUP_2_CLIENT_ID=replace-with-second-backup-client-id
# CDSE_BACKUP_2_CLIENT_SECRET=replace-with-second-backup-client-secret
# Continue through CDSE_BACKUP_9_CLIENT_ID and CDSE_BACKUP_9_CLIENT_SECRET.
