{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terra-project.eu/schemas/uc1/water-selection.schema.json",
  "type": "object",
  "required": ["created_at", "threshold", "selected_tiles", "rejected_tiles", "tiles"],
  "properties": {
    "selected_tiles": {"type": "array", "items": {"type": "string"}},
    "rejected_tiles": {"type": "array", "items": {"type": "string"}},
    "tiles": {"type": "array", "items": {"type": "object", "required": ["name", "selected", "scenes"]}}
  },
  "additionalProperties": true
}
